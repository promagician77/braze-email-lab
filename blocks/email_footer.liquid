<!-- email_footer: legal + preferences. The unsubscribe tag is Braze's standard one; the preference link is whatever your CRM team uses today, kept as is. -->
<tr>
  <td class="bg line-top" style="padding:[[space.xl]]px [[width.gutter]]px [[space.lg]]px [[width.gutter]]px; background-color:[[color.bg]]; border-top:1px solid [[color.line]];" bgcolor="[[color.bg]]">
    <p class="sub" style="margin:0 0 [[space.xs]]px 0; font-family:[[font.stack]]; font-size:[[font.small]]; line-height:[[font.smallLine]]; color:[[color.sub]];">You're receiving this because you saved a wine in the app.</p>
    <p class="sub" style="margin:0; font-family:[[font.stack]]; font-size:[[font.small]]; line-height:[[font.smallLine]]; color:[[color.sub]];">
      <a href="{{ preference_center_url }}" class="sub" style="color:[[color.sub]]; text-decoration:underline;">Email preferences</a> &nbsp;|&nbsp;
      <a href="{{${set_user_to_unsubscribed_url}}}" class="sub" style="color:[[color.sub]]; text-decoration:underline;">Unsubscribe</a>
    </p>
  </td>
</tr>
