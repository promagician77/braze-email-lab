<!-- email_hero: headline + short intro. Text only, so it survives image blocking. -->
<tr>
  <td class="bg" style="padding:[[space.md]]px [[width.gutter]]px [[space.sm]]px [[width.gutter]]px; background-color:[[color.bg]];" bgcolor="[[color.bg]]">
    <h1 class="ink" style="margin:0 0 [[space.xs]]px 0; font-family:[[font.stack]]; font-size:[[font.h1]]; line-height:[[font.h1Line]]; font-weight:700; color:[[color.ink]];">{{ hero_title }}</h1>
    <p class="sub" style="margin:0; font-family:[[font.stack]]; font-size:[[font.body]]; line-height:[[font.bodyLine]]; color:[[color.sub]];">{{ hero_text }}</p>
  </td>
</tr>
